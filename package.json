{
  "name": "trako",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "npm run build && node scripts/serve-built.mjs",
    "prebuild": "node scripts/check-build-env.mjs",
    "build": "npm run typecheck && npm test && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "db:local": "wrangler d1 execute trako-db --local --file",
    "db:remote": "wrangler d1 execute trako-db --remote --file",
    "relay": "node relay/relay.mjs",
    "pretend": "node scripts/pretend-tracker.mjs"
  },
  "allowScripts": {
    "@heroui-pro/react@1.0.0-beta.11": true,
    "@zowe/secrets-for-zowe-sdk@8.29.4": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261103.1": true,
    "workerd@1.20261109.1": true
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.22.0",
    "@heroui-pro/react": "^1.0.0-beta.10",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "maplibre-gl": "^6.9.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.21.0",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  }
}
